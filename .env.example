# Copy to .env.production.local for the Google Play release build. Never commit real values.
# Leave empty during development: purchases stay disabled and ads use Google's test IDs.

# Google Play in-app product ID for FuelBuddy Pro (one-time, non-consumable), e.g. fuelbuddy_pro
VITE_PLAY_PRO_PRODUCT_ID=

# Production AdMob banner ad unit ID (ca-app-pub-xxxxxxxxxxxxxxxx/nnnnnnnnnn)
VITE_ADMOB_BANNER_ID=

# Set to "false" ONLY for the production release, together with VITE_ADMOB_BANNER_ID
VITE_ADS_USE_TEST_IDS=true
