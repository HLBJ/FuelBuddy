# Vite environment variables. Production values are committed in .env.production
# (AdMob IDs are public identifiers). Development builds always use Google's test ads.

# Google Play in-app product ID for FuelBuddy Pro (one-time, non-consumable), e.g. fuelbuddy_pro
VITE_PLAY_PRO_PRODUCT_ID=

# Production AdMob banner ad unit ID
VITE_ADMOB_BANNER_ID=

# "false" enables real ads, and only takes effect in production-mode builds
VITE_ADS_USE_TEST_IDS=true
