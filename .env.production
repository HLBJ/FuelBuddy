# Production-mode build values (used only by `npm run cap:sync:release` / `vite build`).
# AdMob identifiers are public (visible in every published APK), so they are committed.
# Development builds ignore this file and always use Google's test ads.
VITE_ADMOB_BANNER_ID=ca-app-pub-2782099330274635/4533405200
VITE_ADS_USE_TEST_IDS=false

# Set once the one-time "FuelBuddy Pro" product exists in Google Play Console:
VITE_PLAY_PRO_PRODUCT_ID=
